# TapScout v2 hub settings. All optional; copy to .env (never committed) to change them.
# No model API key and no paid service is needed.

# GitHub repository whose device-session workflow runs the devices (default: the origin remote)
TAPSCOUT_GITHUB_REPO=OzzyD07/TapScout-v2
TAPSCOUT_GITHUB_REF=main
# Token for dispatching/cancelling runs (default: the GitHub CLI's `gh auth token`)
GITHUB_TOKEN=

# Public https origin of the runner gateway when you run your own tunnel or port forward.
# Empty: a free Cloudflare quick tunnel (cloudflared, no account) starts for GitHub sessions.
TAPSCOUT_PUBLIC_URL=
TAPSCOUT_TUNNEL=cloudflared

# Local ports (bound to 127.0.0.1): web UI + MCP, and the runner gateway
TAPSCOUT_PORT=4780
TAPSCOUT_GATEWAY_PORT=4781

# Sessions stop after this many minutes without tool calls, and never run longer than the max
TAPSCOUT_IDLE_MINUTES=20
TAPSCOUT_MAX_MINUTES=60

# Long edge of the agent's view space (screenshot pixels = tap coordinates)
TAPSCOUT_VIEW_LONG_EDGE=1280
# Live stream: frames per second in the background (feeds device_recent_frames) and while the
# web UI is open; seconds kept in the live buffer
TAPSCOUT_BACKGROUND_FPS=1
TAPSCOUT_VIEWER_FPS=6
TAPSCOUT_RING_SECONDS=30

# Where sessions, evidence and the hub secret are stored (default: ./.data)
TAPSCOUT_DATA_DIR=
